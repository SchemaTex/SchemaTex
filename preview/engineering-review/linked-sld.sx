sld "Outlet identity — SLD view" standard: iec
U = utility [label:"Utility"]
ISO = switch [label:"Main isolator"]
B = bus [label:"Bus"]
C1 = breaker [label:"Circuit 1"]
C2 = breaker [label:"Circuit 2"]
O11 = load [label:"Outlet 1.1"]
O12 = load [label:"Outlet 1.2"]
O21 = load [label:"Outlet 2.1"]
U -> ISO
ISO -> B
B -> C1
B -> C2
C1 -> O11
C1 -> O12
C2 -> O21
