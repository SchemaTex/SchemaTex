sld "Two-stage PV Side Feed" [standard: ansi]
PV_A = solar [label: "PV Array A", voltage: "600 Vdc", rating: "40 kWdc"]
PV_B = solar [label: "PV Array B", voltage: "600 Vdc", rating: "40 kWdc"]
PV_C = solar [label: "PV Array C", voltage: "600 Vdc", rating: "20 kWdc"]
CMB = hub [label: "DC Combiner", voltage: "600 Vdc"]
UTIL = utility [label: "Utility", voltage: "400 Vac"]
MSB = bus [label: "Main Switchboard", voltage: "400 Vac"]
LOAD = load [label: "Building Loads", rating: "100 kW"]
PV_A -> CMB [cable: "PV1-F 2×35 mm²"]
PV_B -> CMB [cable: "PV1-F 2×35 mm²"]
PV_C -> CMB [cable: "PV1-F 2×25 mm²"]
CMB -> MSB [cable: "4×120 mm² Cu"]
UTIL -> MSB [cable: "Utility feeder"]
MSB -> LOAD [cable: "Main distribution"]
