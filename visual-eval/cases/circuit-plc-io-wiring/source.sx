circuit "PLC Digital I O Field Wiring" netlist
V1 L24 COM type=voltage_source value="24 VDC, 10 A" label="PS1 24 VDC SUPPLY"
F1 L24 L24F type=fuse value="2 A, 250 VDC" label="F1 PLC I/O FUSE"
T1 PB1 PB2 PB3 PE1 INCOM OUT1 OUT2 OUT3 OUT4 OUTCOM type=terminal_block pins="11,12,13,14,15,21,22,23,24,25" value="10-way, 600 V" label="TB1 FIELD I/O"
U1 L24F COM PB1 PB2 PB3 PE1 INCOM OUT1 OUT2 OUT3 OUT4 OUTCOM type=generic_ic pins="L+,M,I0.0,I0.1,I0.2,I0.3,DI-COM,Q0.0,Q0.1,Q0.2,Q0.3,DO-COM" value="24 VDC, 8-point DI/DO" label="PLC1 DIGITAL I/O"
S1 L24F PB1 type=push_no value="24 VDC, 1 A" label="S1 START PB"
S2 L24F PB2 type=push_nc value="24 VDC, 1 A" label="S2 STOP PB NC"
S3 L24F PB3 type=push_no value="24 VDC, 1 A" label="S3 RESET PB"
B1 L24F PE1 type=proximity_sensor value="24 VDC, PNP, 100 mA" label="B1 PROX SENSOR"
W1 INCOM COM value="0.75 mm2, 24 VDC" label="W1 DI COMMON RETURN"
K1 OUT1 COM type=relay_coil value="24 VDC, 2 A contacts" label="K1 CONTROL RELAY"
K2 OUT2 COM type=relay_coil value="24 VDC, 2 A contacts" label="K2 ALARM RELAY"
Y1 OUT3 COM type=solenoid_valve value="24 VDC, 6 W" label="Y1 SOLENOID VALVE"
H1 OUT4 COM type=pilot_light value="24 VDC, 20 mA" label="H1 OUTPUT PILOT"
W2 OUTCOM L24F value="0.75 mm2, 24 VDC" label="W2 DO COMMON +24V"
