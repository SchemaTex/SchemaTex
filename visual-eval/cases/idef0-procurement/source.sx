# Scenario: indirect procurement, from a purchase requisition to a paid supplier invoice.
idef0 "Procurement"
  node A0
  function A1 "Approve requisition"
  function A2 "Select supplier"
  function A3 "Place purchase order"
  function A4 "Match and pay invoice"
  input A1.I "Purchase requisition"
  control A1.C "Spend authority limits"
  mechanism A1.M "Budget holder"
  A1 -> A2 : "Approved requisition"
  control A2.C "Preferred supplier list"
  mechanism A2.M "Buyer"
  A2 -> A3 : "Chosen supplier"
  control A3.C "Contract terms"
  mechanism A3.M "ERP system"
  A3 -> A4 : "Purchase order"
  input A4.I "Supplier invoice"
  control A4.C "Three-way match rule"
  mechanism A4.M "Accounts payable"
  output A4.O "Supplier payment"
