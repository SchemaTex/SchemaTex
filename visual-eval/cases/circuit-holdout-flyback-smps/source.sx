circuit "Isolated Flyback SMPS" netlist
# Offline flyback: rectified 230 VAC input, isolated 5 V output, optocoupler/TL431 regulation.
V1 ACL ACN type=acsource value="230 V AC, 50 Hz" label="AC MAINS"
D1 ACL HVPLUS type=diode value="1N4007" label="D1"
D2 ACN HVPLUS type=diode value="1N4007" label="D2"
D3 HVMINUS ACL type=diode value="1N4007" label="D3"
D4 HVMINUS ACN type=diode value="1N4007" label="D4"
C1 HVPLUS HVMINUS type=ecap value="47 µF, 400 V" label="C1 BULK"
U1 HVPLUS HVMINUS GATE CS FBCTRL type=generic_ic pins="HV+,HV-,GATE,CS,FB" value="UC3843" label="U1 PWM CONTROLLER"
T1 HVPLUS SW VSEC GNDSEC type=transformer value="EE16 flyback" label="T1 ISOLATION TRANSFORMER"
M1 SW GATE CS type=nmos value="STP7NK80Z" label="Q1 PRIMARY SWITCH"
R1 CS HVMINUS value="0.33 Ω" label="RSENSE"
D5 VSEC VOUT type=schottky value="SS34" label="D5 SECONDARY RECTIFIER"
C2 VOUT GNDSEC type=ecap value="470 µF, 10 V" label="C2 OUTPUT"
R2 VOUT GNDSEC value="10 Ω, 5 W" label="RLOAD"
R3 VOUT LEDA value="1 kΩ" label="RLED"
U3 FBSEC VREF GNDSEC type=generic_ic pins="K,REF,A" value="TL431A" label="U2 SHUNT REGULATOR"
R4 VOUT VREF value="10 kΩ, 1%" label="RTOP"
R5 VREF GNDSEC value="2.49 kΩ, 1%" label="RBOT"
U4 LEDA FBSEC FBCTRL HVMINUS type=optocoupler value="LTV-817" label="U3 OPTOCOUPLER"
W1 HVMINUS GND type=wire value="primary return bond" label="PRIMARY GROUND"
