# Horizontally scaled web application architecture with asynchronous job processing.
blockdiagram "Web Application Architecture"
client = block("Browser Client") [role: input]
cdn = block("CDN / WAF") [role: generic]
lb = block("Load Balancer") [role: generic]
app1 = block("App Server A") [role: controller]
app2 = block("App Server B") [role: controller]
cache = block("Redis Cache") [role: generic]
db = block("PostgreSQL Database") [role: generic]
queue = block("Job Queue") [role: generic]
worker1 = block("Worker A") [role: actuator]
worker2 = block("Worker B") [role: actuator]
client -> cdn ["HTTPS"]
cdn -> lb ["origin HTTPS"]
lb -> app1 ["requests"]
lb -> app2 ["requests"]
app1 -> cache ["cache read/write"]
app2 -> cache ["cache read/write"]
app1 -> db ["SQL"]
app2 -> db ["SQL"]
app1 -> queue ["enqueue jobs"]
app2 -> queue ["enqueue jobs"]
queue -> worker1 ["job message"]
queue -> worker2 ["job message"]
worker1 -> db ["result write"]
worker2 -> db ["result write"]
