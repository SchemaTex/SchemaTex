circuit "Three-Op-Amp Instrumentation Amplifier" netlist
# ±15 V rails; gain is set by RG between the two input-stage inverting nodes.
VP VPOS GND value="15 V" label="V+ SUPPLY"
VN VNEG GND value="-15 V" label="V- SUPPLY"
V1 INP GND type=acsource value="10 mV differential input" label="VIN+"
V2 INN GND type=acsource value="10 mV differential input" label="VIN-"
U1 INP N1 OA1OUT type=opamp value="OPA197" label="U1 INPUT BUFFER A"
U2 INN N2 OA2OUT type=opamp value="OPA197" label="U2 INPUT BUFFER B"
RG N1 N2 value="1 kΩ" label="RG GAIN SET"
R1 OA1OUT N1 value="10 kΩ" label="R1"
R2 OA2OUT N2 value="10 kΩ" label="R2"
U3 PDIFF NDIFF OUT type=opamp value="OPA197" label="U3 DIFFERENCE AMP"
R3 OA1OUT NDIFF value="10 kΩ, 0.1%" label="R3"
R4 OUT NDIFF value="10 kΩ, 0.1%" label="R4"
R5 OA2OUT PDIFF value="10 kΩ, 0.1%" label="R5"
R6 PDIFF GND value="10 kΩ, 0.1%" label="R6"
W1 VPOS U1.supply+ type=wire value="+15 V rail" label="U1 V+"
W2 VNEG U1.supply- type=wire value="-15 V rail" label="U1 V-"
W3 VPOS U2.supply+ type=wire value="+15 V rail" label="U2 V+"
W4 VNEG U2.supply- type=wire value="-15 V rail" label="U2 V-"
W5 VPOS U3.supply+ type=wire value="+15 V rail" label="U3 V+"
W6 VNEG U3.supply- type=wire value="-15 V rail" label="U3 V-"
