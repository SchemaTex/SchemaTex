# Moreno sociogram: students' preferred study partners show a reciprocal cluster and a peripheral learner.
sociogram "Exam Study Group Preferences"
  config: highlight = stars, isolates, cliques
  iman
  jules
  kai
  lena
  min
  noah
  iman <-> jules
  jules <-> kai
  kai <-> iman
  lena -> iman
  min -> jules
  noah
