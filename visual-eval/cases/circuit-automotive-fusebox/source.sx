circuit "12 V Vehicle Accessory Fuse Box" netlist
B1 BAT_POS CHASSIS 12V type=battery label="B1 START BATTERY"
S1 BAT_POS MAIN_FEED type=switch_spst value="300 A, 12 VDC" label="S1 MAIN ISOLATOR"
F1 MAIN_FEED FUSED_BUS type=fuse value="100 A MEGA" label="F1 MAIN FUSE"
F2 FUSED_BUS LIGHT_FEED type=fuse value="20 A ATO" label="F2 DRIVING LIGHTS"
F3 FUSED_BUS COMP_FEED type=fuse value="40 A MAXI" label="F3 COMPRESSOR"
F4 FUSED_BUS DASH_FEED type=fuse value="10 A ATO" label="F4 DASH PANEL"
F5 FUSED_BUS ACC_FEED type=fuse value="15 A ATO" label="F5 ACCESSORIES"
F6 FUSED_BUS AUX_FEED type=fuse value="5 A ATO" label="F6 AUXILIARY"
K1 LIGHT_FEED CHASSIS type=relay_coil value="12 VDC, 30 A contacts" label="K1 LIGHT RELAY"
K1A LIGHT_FEED LIGHT_OUT type=relay_no value="30 A, 14 VDC" label="K1 NO CONTACT"
L1 LIGHT_OUT CHASSIS type=lamp value="2 x 55 W, 12 V" label="L1 DRIVING LIGHTS"
K2 COMP_FEED CHASSIS type=relay_coil value="12 VDC, 40 A contacts" label="K2 COMPRESSOR RELAY"
K2A COMP_FEED COMP_OUT type=relay_no value="40 A, 14 VDC" label="K2 NO CONTACT"
M1 COMP_OUT CHASSIS type=motor value="12 VDC, 30 A" label="M1 AIR COMPRESSOR"
S2 DASH_FEED LIGHT_FEED type=switch_spst value="12 VDC, 1 A" label="S2 LIGHT SWITCH"
S3 DASH_FEED COMP_FEED type=switch_spst value="12 VDC, 1 A" label="S3 COMPRESSOR SWITCH"
H1 LIGHT_FEED CHASSIS type=pilot_light value="12 VDC, amber" label="H1 LIGHT ON"
H2 COMP_FEED CHASSIS type=pilot_light value="12 VDC, green" label="H2 COMPRESSOR ON"
L2 ACC_FEED CHASSIS type=lamp value="12 VDC, 21 W" label="L2 ACCESSORY LAMP"
L3 AUX_FEED CHASSIS type=lamp value="12 VDC, 5 W" label="L3 AUXILIARY LAMP"
G1 CHASSIS 0 type=gnd_chassis value="vehicle chassis" label="G1 CHASSIS EARTH"
