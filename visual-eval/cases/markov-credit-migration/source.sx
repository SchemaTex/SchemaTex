# Scenario: one-year credit rating migration; default is absorbing, every row sums to one.
markov "Annual credit rating migration"
  analysis: classify, absorbing
  state AA
  state A
  state BBB
  state BB
  state D "Default" absorbing
  AA -> AA : 0.90
  AA -> A : 0.08
  AA -> BBB : 0.02
  A -> AA : 0.03
  A -> A : 0.88
  A -> BBB : 0.08
  A -> BB : 0.01
  BBB -> A : 0.05
  BBB -> BBB : 0.85
  BBB -> BB : 0.08
  BBB -> D : 0.02
  BB -> BBB : 0.07
  BB -> BB : 0.80
  BB -> D : 0.13
  D -> D : 1.0
