sld "Solar Project — Skid MT 01 — Detalhamento Unifilar 0,8/33 kV"
INV01 = load [rating: "350 kW", voltage: "800V", label: "Inversor 01 — 350 kW / 50 Hz"]
INV02 = load [rating: "350 kW", voltage: "800V", label: "Inversor 02 — 350 kW / 50 Hz"]
