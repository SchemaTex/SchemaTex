# Scenario: e-commerce warehouse fulfilment, from a paid order to a parcel handed to the carrier.
idef0 "Order Fulfilment"
  node A0
  function A1 "Allocate stock"
  function A2 "Pick items"
  function A3 "Pack order"
  function A4 "Ship parcel"
  input A1.I "Paid order"
  control A1.C "Allocation rules"
  mechanism A1.M "Warehouse system"
  A1 -> A2 : "Pick list"
  control A2.C "Pick route"
  mechanism A2.M "Pickers"
  A2 -> A3 : "Picked items"
  control A3.C "Packaging standard"
  mechanism A3.M "Packing station"
  A3 -> A4 : "Packed order"
  control A4.C "Carrier cut-off times"
  mechanism A4.M "Parcel carrier"
  output A4.O "Shipped parcel"
