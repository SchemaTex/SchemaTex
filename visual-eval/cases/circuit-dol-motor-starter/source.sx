circuit "Direct-On-Line Motor Starter" netlist
V1 L1 GND type=ac_source value="230 V AC phase L1" label="V1 L1"
V2 L2 GND type=ac_source value="230 V AC phase L2" label="V2 L2"
V3 L3 GND type=ac_source value="230 V AC phase L3" label="V3 L3"
QF1 L1 B1 type=disconnect_switch value="16 A, 3-pole" label="QF1 BREAKER L1"
QF2 L2 B2 type=disconnect_switch value="16 A, 3-pole" label="QF1 BREAKER L2"
QF3 L3 B3 type=disconnect_switch value="16 A, 3-pole" label="QF1 BREAKER L3"
KM1A B1 OL1 type=contactor value="18 A main pole" label="KM1 MAIN L1"
KM1B B2 OL2 type=contactor value="18 A main pole" label="KM1 MAIN L2"
KM1C B3 OL3 type=contactor value="18 A main pole" label="KM1 MAIN L3"
F1A OL1 U type=thermal_overload value="9-13 A" label="F1 OVERLOAD L1"
F1B OL2 V type=thermal_overload value="9-13 A" label="F1 OVERLOAD L2"
F1C OL3 W type=thermal_overload value="9-13 A" label="F1 OVERLOAD L3"
M1 U V W type=generic_ic pins="U,V,W" value="400 V, 5.5 kW" label="M1 3-PH MOTOR"
S0 L1 STOP type=push_nc value="STOP NC" label="S0 STOP"
F1X STOP OL type=thermal_overload value="95-96 NC" label="F1 AUX NC"
F1Y L1 TRIP type=thermal_overload value="97-98 NO" label="F1 TRIP NO"
S1 OL START type=push_no value="START NO" label="S1 START"
K1 START GND type=relay_coil value="230 VAC" label="KM1 COIL"
K1A OL START type=relay_no value="KM1 aux NO" label="KM1 SEAL-IN"
H1 START GND type=pilot_light value="Green 230 VAC" label="H1 RUNNING"
H2 TRIP GND type=pilot_light value="Red 230 VAC" label="H2 TRIPPED"
