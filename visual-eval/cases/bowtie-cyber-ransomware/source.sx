# Assumptions: the organisation operates managed endpoints, a segregated backup service, and an incident response team.
# The top event is execution of ransomware on a production endpoint.
bowtie "Cyber ransomware incident"
hazard "Enterprise data and production IT services"
topevent "Ransomware executes on production endpoint"
threat "Phishing email attachment"
  prevent "Email filtering and sandboxing"
  prevent "Security-awareness training"
threat "Stolen remote-access credentials"
  prevent "Multi-factor authentication"
    escalation "MFA fatigue approval"
      barrier "Number-matching authentication"
  prevent "Conditional access policy"
threat "Unpatched internet-facing service"
  prevent "Vulnerability patch management"
  prevent "Web application firewall"
consequence "Business data encrypted"
  mitigate "Immutable offline backups"
  mitigate "Tested restoration runbook"
consequence "Lateral spread to clinical systems"
  mitigate "Network segmentation"
  mitigate "Endpoint detection and response"
consequence "Extended service outage"
  mitigate "Cyber incident response team"
