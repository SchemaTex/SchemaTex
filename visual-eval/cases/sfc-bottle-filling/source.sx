# Scenario: IEC 61131-3 bottle filling: fill, weigh, then cap a good bottle or reject a light one.
sfc "Bottle filling with weight check"
var BottleInPlace: bool
var LevelReached: bool
var WeightOK: bool
var CapDone: bool
var RejectDone: bool
var BottleClear: bool
step S0 [initial]
  N ConveyorRun
step S1 [label: "Fill"]
  N FillValveOpen
step S2 [label: "Weigh"]
  P WeighBottle
alt from: S2:
  branch [priority: 1]:
    transition: WeightOK
    step S3 [label: "Cap"]
      N CapperRun
    transition: CapDone
  branch [priority: 2]:
    transition: NOT WeightOK
    step S4 [label: "Reject"]
      N RejectArmOut
    transition: RejectDone
merge_to: S5
step S5 [label: "Release bottle"]
  N ConveyorRun
transition from: S0 to: S1: BottleInPlace
transition from: S1 to: S2: LevelReached
transition from: S5 to: S0: BottleClear
