# Superheterodyne radar receive chain with a local oscillator feeding the mixer.
blockdiagram "Radar Receiver"
antenna = block("Receive Antenna") [role: input]
duplexer = block("Duplexer") [role: generic]
lna = block("Low-Noise Amplifier") [role: generic]
mixer = block("Downconversion Mixer") [role: generic]
ifamp = block("IF Amplifier") [role: generic]
filter = block("IF Band-Pass Filter") [role: generic]
adc = block("ADC") [role: generic]
processor = block("Radar Signal Processor") [role: controller]
display = block("Track Display") [role: output]
lo = block("Local Oscillator") [role: reference]
antenna -> duplexer ["received RF"]
duplexer -> lna ["RF"]
lna -> mixer ["amplified RF"]
lo -> mixer ["LO injection"]
mixer -> ifamp ["intermediate frequency"]
ifamp -> filter ["IF"]
filter -> adc ["filtered IF"]
adc -> processor ["digital samples"]
processor -> display ["tracks"]
