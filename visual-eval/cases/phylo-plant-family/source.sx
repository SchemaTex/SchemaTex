# Angiosperm family tree: legumes form a highlighted Fabaceae clade distinct from rosids and asterids.
phylo "Flowering Plant Families" [layout: rectangular, mode: phylogram]
  newick: "((Fabaceae:0.12,Rosaceae:0.14):0.10,(Asteraceae:0.19,Lamiaceae:0.17):0.08):0.22;"
  clade Rosids = (Fabaceae, Rosaceae) [color: "#43A047"]
  scale "substitutions/site"
