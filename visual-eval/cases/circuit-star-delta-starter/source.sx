Q2 L2 B2 type=disconnect_switch value="25 A, 3-pole, 400 VAC" label="QF1 BREAKER L2"
Q3 L3 B3 type=disconnect_switch value="25 A, 3-pole, 400 VAC" label="QF1 BREAKER L3"
