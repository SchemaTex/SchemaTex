ladder "コンベヤーベルトシステム"
rung 1 "シールイン回路":
  parallel:
    branch:
      XIC(START_PB, "IN 1.0", name="起動ボタン")
    branch:
      XIC(MOTOR_AUX, "BIT 3.0", name="モーター補助接点")
