# Assumptions: this bowtie covers one pressurised hydrocarbon vessel and its normal operating envelope.
# Barriers are independent safeguards; the corrosion inspection interval is controlled by RBI.
bowtie "Hydrocarbon vessel loss of containment"
hazard "Pressurised hydrocarbon inventory"
topevent "Loss of containment from vessel"

threat "Vessel wall corrosion"
  prevent "Corrosion-resistant coating"
  prevent "Ultrasonic thickness inspection"
    escalation "Inspection interval becomes excessive"
      barrier "Risk-based inspection programme"
  prevent "Cathodic protection"
threat "Overpressure during filling"
  prevent "High-pressure shutdown trip"
  prevent "Pressure relief valve"
threat "Mechanical impact by vehicle"
  prevent "Vehicle exclusion zone"
  prevent "Impact bollards"
threat "Flange gasket degradation"
  prevent "Specified gasket material"
  prevent "Torque-controlled bolting inspection"

consequence "Jet fire"
  mitigate "Gas detection and emergency shutdown"
  mitigate "Deluge water spray"
  mitigate "Fireproofing of supports"
consequence "Vapour cloud explosion"
  mitigate "Gas detection and emergency shutdown"
  mitigate "Ignition-source control"
  mitigate "Blast-resistant control room"
consequence "Personnel hydrocarbon exposure"
  mitigate "Personal gas monitors"
  mitigate "Emergency evacuation plan"
