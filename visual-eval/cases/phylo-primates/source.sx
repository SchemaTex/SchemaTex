# Molecular primate phylogeny with branch lengths; human and chimpanzee are sister taxa within highlighted Homininae.
phylo "Primate Phylogeny" [layout: rectangular, mode: phylogram]
  newick: "(((Human:0.006,Chimpanzee:0.006):0.007,Gorilla:0.013):0.018,Orangutan:0.031):0.025,Gibbon:0.056;"
  clade Homininae = (Human, Chimpanzee, Gorilla) [color: "#1E88E5"]
  scale "substitutions/site"
