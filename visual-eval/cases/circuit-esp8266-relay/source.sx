circuit "ESP8266 Dual Relay Controller" netlist
V1 VIN GND value="5 V DC" label="V1"
U1 VIN GND V33 type=voltage_regulator value="AMS1117-3.3, 3.3 V" label="U1"
C1 VIN GND type=ecap value="47 µF, 10 V" label="C1"
C2 V33 GND value="100 nF" label="C2"
U2 EN IN1 IN2 V33 GND type=generic_ic pins="EN,GPIO12,GPIO13,3V3,GND" value="ESP-12E / ESP8266" label="U2"
R1 V33 EN value="10 kΩ" label="R1"
R2 IN1 B1 value="1 kΩ" label="R2"
R3 IN2 B2 value="1 kΩ" label="R3"
Q1 COIL1 B1 GND type=npn value="2N2222A" label="Q1"
Q2 COIL2 B2 GND type=npn value="2N2222A" label="Q2"
K1 VIN COIL1 type=relay_coil value="SRD-05VDC-SL-C" label="K1 RELAY 1"
K2 VIN COIL2 type=relay_coil value="SRD-05VDC-SL-C" label="K2 RELAY 2"
D1 COIL1 VIN value="1N4007" label="D1"
D2 COIL2 VIN value="1N4007" label="D2"
R4 VIN LED1 value="1 kΩ" label="R4"
R5 VIN LED2 value="1 kΩ" label="R5"
D3 LED1 COIL1 type=led value="Green" label="D3 RELAY 1"
D4 LED2 COIL2 type=led value="Green" label="D4 RELAY 2"
