# Scenario: IEC 61131-3 compressor start-up: permissives, lube pump, warning horn, main motor; any trip returns to idle.
sfc "Compressor start-up interlock"
var StartBtn: bool
var PermissivesOK: bool
var LubePressureOK: bool
var MotorAtSpeed: bool
var Trip: bool
var StopBtn: bool
step S0 [initial]
  N MotorOff
step S1 [label: "Check permissives"]
  P RunChecks
step S2 [label: "Start lube pump"]
  N LubePump
step S3 [label: "Start main motor"]
  N LubePump
  N MainMotor
  L StartHorn T#3s
step S4 [label: "Running"]
  N MainMotor
transition from: S0 to: S1: StartBtn
transition from: S1 to: S2: PermissivesOK
transition from: S2 to: S3: LubePressureOK
transition from: S3 to: S4: MotorAtSpeed
transition T_Trip from: S2 to: S0: Trip
transition from: S4 to: S0: Trip OR StopBtn
