# European history across classical, medieval, and early modern periods.
timeline "Europe: Classical to Early Modern"
config: orientation = horizontal
config: scale = proportional
era -509 - 476: "Classical Antiquity"
era 476 - 1000: "Early Middle Ages"
era 1000 - 1450: "High and Late Middle Ages"
era 1450 - 1700: "Early Modern Era"
track "Political and Cultural Events":
  -509: milestone "Roman Republic established"
  -44: "Caesar assassinated"
  476: milestone "Western Roman Empire falls"
  800: "Charlemagne crowned emperor"
  1066: milestone "Norman Conquest"
  1215: "Magna Carta sealed"
  1347 - 1353: "Black Death in Europe"
  1453: milestone "Fall of Constantinople"
  1492: "Columbus reaches the Americas"
  1517: "Luther's Ninety-five Theses"
  1648: milestone "Peace of Westphalia"
