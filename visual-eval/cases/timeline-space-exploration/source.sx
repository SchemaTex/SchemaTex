# Major milestones in space exploration; dates are historical calendar dates.
timeline "Space Exploration Milestones"
config: orientation = horizontal
config: scale = proportional
track "Earth Orbit":
  1957-10-04: milestone "Sputnik 1"
  1961-04-12: "First human orbital flight"
track "Moon":
  1969-07-20: milestone "Apollo 11 lunar landing"
  1972-12-14: "Apollo 17 final Moonwalk"
track "Deep Space":
  1977-09-05: "Voyager 1 launch"
  1990-02-14: "Pale Blue Dot image"
track "Mars":
  1997-07-04: "Mars Pathfinder landing"
  2021-02-18: milestone "Perseverance rover landing"
  2022-07-12: "JWST first images"
