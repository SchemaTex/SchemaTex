# Scenario: Event-driven order-to-cash process.
epc "Order to Cash"
  layout: tb
  event E1 "Order received"
  function F1 "Check credit"
  xor X1
  event E2 "Credit approved"
  event E3 "Credit declined"
  function F2 "Ship goods"
  function F3 "Notify customer"
  event E4 "Goods shipped"
  event E5 "Order cancelled"
  E1 -> F1 -> X1
  X1 -> E2 -> F2 -> E4
  X1 -> E3 -> F3 -> E5
