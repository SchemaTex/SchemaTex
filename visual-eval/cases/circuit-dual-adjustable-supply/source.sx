circuit "Dual Adjustable Bench Supply" netlist
V1 LINE NEUTRAL type=ac_source value="230 V AC, 50 Hz" label="V1"
T1 LINE NEUTRAL SEC_P CT SEC_N type=transformer value="230 V : 2 × 18 V AC" label="T1"
W1 CT GND label="Centre Tap 0 V"
D1 SEC_P RAW_P value="1N5408" label="D1 BR1"
D2 SEC_N RAW_P value="1N5408" label="D2 BR1"
D3 RAW_N SEC_P value="1N5408" label="D3 BR1"
D4 RAW_N SEC_N value="1N5408" label="D4 BR1"
C1 RAW_P GND type=ecap value="2200 µF, 35 V" label="C1"
C2 GND RAW_N type=ecap value="2200 µF, 35 V" label="C2"
U1 RAW_P ADJ_P VPOS type=voltage_regulator value="LM317" label="U1"
U2 RAW_N ADJ_N VNEG type=voltage_regulator value="LM337" label="U2"
R1 VPOS ADJ_P value="240 Ω" label="R1"
P1 ADJ_P GND VPOS type=potentiometer value="5 kΩ" label="P1 +V ADJUST"
R2 ADJ_N VNEG value="240 Ω" label="R2"
P2 GND ADJ_N VNEG type=potentiometer value="5 kΩ" label="P2 −V ADJUST"
C3 VPOS GND type=ecap value="10 µF, 35 V" label="C3"
C4 GND VNEG type=ecap value="10 µF, 35 V" label="C4"
D5 ADJ_P VPOS value="1N4007" label="D5"
D6 VPOS RAW_P value="1N4007" label="D6"
D7 VNEG ADJ_N value="1N4007" label="D7"
D8 RAW_N VNEG value="1N4007" label="D8"
