circuit "Three Contactor Interlocked Control" netlist
V1 L1 GND type=ac_source value="120 V AC control" label="V1"
S0 L1 STOP type=switch_nc value="STOP" label="S0 STOP NC"
F1 STOP OL type=thermal_overload value="95-96 NC" label="F1 OVERLOAD"
S1 OL START_F type=push_no value="START FORWARD" label="S1"
K1 START_F GND type=relay_coil value="120 V AC coil" label="KM1 FORWARD COIL"
K1A OL START_F type=relay_no value="KM1 seal-in" label="KM1 AUX NO"
S2 OL REV_LOCK type=push_no value="START REVERSE" label="S2"
K1B REV_LOCK REV_COIL type=relay_nc value="KM1 interlock" label="KM1 NC"
K2 REV_COIL GND type=relay_coil value="120 V AC coil" label="KM2 REVERSE COIL"
K2A OL REV_COIL type=relay_no value="KM2 seal-in" label="KM2 AUX NO"
K3A OL STAR_LOCK type=push_no value="START STAR" label="S3"
K2B STAR_LOCK STAR_COIL type=relay_nc value="KM2 interlock" label="KM2 NC"
K3 STAR_COIL GND type=relay_coil value="120 V AC coil" label="KM3 STAR COIL"
K3B OL STAR_COIL type=relay_no value="KM3 seal-in" label="KM3 AUX NO"
L1F START_F GND type=pilot_light value="Green, FORWARD" label="H1"
L2R REV_COIL GND type=pilot_light value="Amber, REVERSE" label="H2"
L3S STAR_COIL GND type=pilot_light value="Blue, STAR" label="H3"
