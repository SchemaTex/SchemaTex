circuit "Domestic Consumer Unit" netlist
V1 LINE_IN NEUTRAL_IN type=ac_source value="230 V AC, 50 Hz, 63 A" label="V1 INCOMING SUPPLY"
S0 LINE_IN LINE_MAIN type=disconnect_switch value="63 A, 2-pole" label="S0 MAIN SWITCH"
Q1 LINE_MAIN LINE_RCD type=disconnect_switch value="63 A, 30 mA, Type A" label="Q1 RCD"
QF1 LINE_RCD L_LIGHT type=disconnect_switch value="6 A, B-curve, 6 kA" label="QF1 MCB LIGHTING"
QF2 LINE_RCD L_SOCKET type=disconnect_switch value="32 A, B-curve, 6 kA" label="QF2 MCB SOCKETS"
QF3 LINE_RCD L_COOKER type=disconnect_switch value="32 A, B-curve, 6 kA" label="QF3 MCB COOKER"
QF4 LINE_RCD L_SHOWER type=disconnect_switch value="40 A, B-curve, 6 kA" label="QF4 MCB SHOWER"
QF5 LINE_RCD L_OUTSIDE type=disconnect_switch value="16 A, B-curve, 6 kA" label="QF5 MCB OUTSIDE"
QF6 LINE_RCD L_SPARE type=disconnect_switch value="20 A, B-curve, 6 kA" label="QF6 MCB SPARE"
L1 L_LIGHT N_LIGHT type=lamp value="230 V, 100 W" label="L1 LIGHTING FINAL CIRCUIT"
U1 L_SOCKET N_SOCKET type=mains_socket value="230 V, 32 A ring" label="U1 SOCKETS FINAL CIRCUIT"
U2 L_COOKER N_COOKER type=generic_ic pins="L,N" value="230 V, 7.2 kW" label="U2 COOKER FINAL CIRCUIT"
U3 L_SHOWER N_SHOWER type=generic_ic pins="L,N" value="230 V, 9 kW" label="U3 SHOWER FINAL CIRCUIT"
U4 L_OUTSIDE N_OUTSIDE type=mains_socket value="230 V, 16 A" label="U4 OUTSIDE FINAL CIRCUIT"
U5 L_SPARE N_SPARE type=generic_ic pins="L,N" value="230 V, 20 A reserved" label="U5 SPARE WAY"
TN1 NEUTRAL_IN N_LIGHT N_SOCKET N_COOKER N_SHOWER N_OUTSIDE N_SPARE type=terminal_block pins="IN,N1,N2,N3,N4,N5,N6" value="100 A, 7-way" label="TN1 NEUTRAL BAR"
TE1 PE_LIGHT PE_SOCKET PE_COOKER PE_SHOWER PE_OUTSIDE PE_SPARE type=terminal_block pins="PE1,PE2,PE3,PE4,PE5,PE6" value="100 A, 6-way" label="TE1 EARTH BAR"
W1 PE_LIGHT EARTH type=wire value="1.5 mm2 CPC" label="W1 EARTH / PE"
W2 PE_SOCKET EARTH type=wire value="2.5 mm2 CPC" label="W2 EARTH / PE"
W3 PE_COOKER EARTH type=wire value="6 mm2 CPC" label="W3 EARTH / PE"
W4 PE_SHOWER EARTH type=wire value="10 mm2 CPC" label="W4 EARTH / PE"
W5 PE_OUTSIDE EARTH type=wire value="2.5 mm2 CPC" label="W5 EARTH / PE"
W6 PE_SPARE EARTH type=wire value="2.5 mm2 CPC" label="W6 EARTH / PE"
