circuit "Off Grid Solar DC System" netlist
P1 PV_POS1 PV_NEG1 type=solar_cell value="200 W, 24 V" label="P1 PV PANEL"
P2 PV_NEG1 PV_NEG2 type=solar_cell value="200 W, 24 V" label="P2 PV PANEL"
S1 PV_POS1 PV_POS_CTRL type=switch_spst value="32 VDC, 20 A" label="S1 PV ISOLATOR"
U1 PV_POS_CTRL PV_NEG2 BAT_POS CHASSIS type=generic_ic pins="PV+,PV-,BAT+,BAT-" value="40 A, 12/24 V" label="U1 MPPT CONTROLLER"
B1 BAT_POS CHASSIS 12V type=battery label="B1 BATTERY BANK A"
B2 BAT_POS CHASSIS 12V type=battery label="B2 BATTERY BANK B"
F1 BAT_POS DC_BUS type=fuse value="60 A MIDI" label="F1 DC DISTRIBUTION"
F2 DC_BUS LOAD_12V type=fuse value="15 A ATO" label="F2 12 V LOAD FUSE"
L1 LOAD_12V CHASSIS type=lamp value="12 VDC, 30 W" label="L1 DC LOADS"
F3 DC_BUS INV_POS type=fuse value="125 A CLASS T" label="F3 INVERTER FUSE"
U2 INV_POS CHASSIS AC_L AC_N type=dc_dc_converter value="1200 W, 12 VDC to 230 VAC" label="U2 INVERTER"
X1 AC_L AC_N type=mains_socket value="230 VAC, 13 A" label="X1 AC SOCKET"
G1 CHASSIS 0 type=gnd_chassis value="DC negative bond" label="G1 DC EARTH"
