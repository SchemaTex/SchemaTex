# Assumptions: the trait is Y-linked with complete penetrance, so affected fathers transmit it to all sons only.
# Female relatives are unaffected because they do not inherit the Y chromosome.
pedigree "Y-linked inheritance family"
  I-1 [male, affected]
  I-2 [female, unaffected]
  I-1 -- I-2
    II-1 [male, affected]
    II-2 [female, unaffected]
    II-3 [male, affected]
  II-4 [female, unaffected]
  II-1 -- II-4
    III-1 [male, affected, proband]
    III-2 [female, unaffected]
