circuit "VFD Motor Power and Control Wiring" netlist
V1 L1 PE type=ac_source value="400 VAC, 50 Hz" label="V1 L1 SUPPLY"
V2 L2 PE type=ac_source value="400 VAC, 50 Hz" label="V2 L2 SUPPLY"
V3 L3 PE type=ac_source value="400 VAC, 50 Hz" label="V3 L3 SUPPLY"
Q1 L1 QL1 type=disconnect_switch value="16 A, 3-pole, 400 VAC" label="QF1 BREAKER L1"
Q2 L2 QL2 type=disconnect_switch value="16 A, 3-pole, 400 VAC" label="QF1 BREAKER L2"
Q3 L3 QL3 type=disconnect_switch value="16 A, 3-pole, 400 VAC" label="QF1 BREAKER L3"
L1 QL1 R1 type=inductor_iron value="16 A, 3%, 400 VAC" label="LR1 LINE REACTOR L1"
L2 QL2 R2 type=inductor_iron value="16 A, 3%, 400 VAC" label="LR1 LINE REACTOR L2"
L3 QL3 R3 type=inductor_iron value="16 A, 3%, 400 VAC" label="LR1 LINE REACTOR L3"
U1 R1 R2 R3 U V W BRP BRN RUN FWD AI COM FAULT type=generic_ic pins="R/L1,S/L2,T/L3,U/T1,V/T2,W/T3,P+,PB,DI1,DI2,AI1,AC,RA" value="400 VAC, 4 kW" label="VFD1 VARIABLE FREQUENCY DRIVE"
M1 U V W type=generic_ic pins="U1,V1,W1" value="400 VAC, 4 kW, 8.5 A" label="M1 3-PH MOTOR"
R4 BRP BRN type=resistor value="100 ohm, 300 W" label="RB1 BRAKING RESISTOR"
S1 RUN COM type=push_no value="24 VDC, 1 A" label="S1 RUN COMMAND"
S2 FWD COM type=selector_switch value="24 VDC, 1 A" label="S2 FORWARD REVERSE"
P1 VREF10 AI COM type=potentiometer value="10 kohm, 0.25 W" label="P1 SPEED POT"
K1 FAULT COM type=relay_no value="250 VAC, 2 A" label="K1 VFD FAULT RELAY"
