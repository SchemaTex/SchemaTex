# Scenario: Joint Venture legal entity and ownership structure.
entity-structure "Joint Venture"
entity parent "Parent Holdings, Inc." corp@DE
entity opco "Operating Company, LLC" llc@DE
entity ipco "IP Company Ltd" corp@IE
entity services "Services Company, Inc." corp@DE
parent -> opco : 100%
parent -> ipco : 100%
parent -> services : 100%

