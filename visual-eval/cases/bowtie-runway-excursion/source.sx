# Assumptions: the scenario is a landing on a runway with the published landing-performance data available.
# Each listed barrier is credited only on the threat or consequence path it directly addresses.
bowtie "Aviation runway excursion"
hazard "Aircraft landing operation"
topevent "Runway excursion on landing"

threat "Unstable approach"
  prevent "Stabilised-approach criteria"
  prevent "Mandatory go-around policy"
  prevent "Approach monitoring callouts"
threat "Contaminated runway"
  prevent "Runway condition reporting"
  prevent "Landing performance assessment"
    escalation "Contamination report is out of date"
      barrier "Runway inspection and report update"
threat "Excessive landing speed"
  prevent "Energy-management standard operating procedure"
  prevent "Autobrake selection verification"
threat "Late touchdown"
  prevent "Touchdown-zone monitoring"
  prevent "Go-around decision gate"

consequence "Aircraft hull damage"
  mitigate "Runway end safety area"
  mitigate "Engineered materials arrestor system"
consequence "Passenger or crew injury"
  mitigate "Cabin brace and evacuation procedure"
  mitigate "Airport rescue and firefighting response"
consequence "Runway closure and disruption"
  mitigate "Rapid aircraft recovery plan"
  mitigate "Runway inspection and reopening procedure"
