# Gate-level 2-bit magnitude comparator (A1A0 vs B1B0).
# EQ is the NOR of the two bit-difference XORs; GT compares the high bit first
# and falls through to the low bit when the high bits match; LT is everything else.
logic "2-bit Magnitude Comparator"
input A1, A0, B1, B0
output GT, EQ, LT
nB1 = NOT(B1)
nB0 = NOT(B0)
d1 = XOR(A1, B1)
d0 = XOR(A0, B0)
EQ = NOR(d1, d0)
e1 = NOT(d1)
g1 = AND(A1, nB1)
g0 = AND(e1, A0, nB0)
GT = OR(g1, g0)
LT = NOR(GT, EQ)
