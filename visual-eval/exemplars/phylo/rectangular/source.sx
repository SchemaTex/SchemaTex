phylo "Bacterial diversity" [layout: rectangular, mode: phylogram]
  # Illustrative data for a design reference, not a tree inferred from sequences.
  newick: "(((Escherichia_coli:0.04,Salmonella_enterica:0.05)[&&NHX:B=99]:0.06,Vibrio_cholerae:0.12)[&&NHX:B=96]:0.12,((Bacillus_subtilis:0.07,Staphylococcus_aureus:0.09)[&&NHX:B=94]:0.05,Listeria_monocytogenes:0.15)[&&NHX:B=98]:0.10,(Mycobacterium_tuberculosis:0.16,Streptomyces_coelicolor:0.18)[&&NHX:B=97]:0.12);"
  clade Proteobacteria = (Escherichia_coli, Salmonella_enterica, Vibrio_cholerae) [color: "#0f766e", highlight: both]
  clade Firmicutes = (Bacillus_subtilis, Staphylococcus_aureus, Listeria_monocytogenes) [color: "#2563eb", highlight: both]
  clade Actinobacteria = (Mycobacterium_tuberculosis, Streptomyces_coelicolor) [color: "#a16207", highlight: both]
  scale "substitutions/site"
