# Closed-loop speed control of a BLDC robot-joint servo drive, as drawn for a design review.
blockdiagram "BLDC Joint Servo — Closed-Loop Speed Control"
cmd = block("Motion Command\nSpeed Setpoint") [role: reference]
pid = block("PID Speed\nController") [role: controller]
curlim = block("Current Limiter") [role: controller]
pwm = block("PWM Modulator\n20 kHz") [role: controller]
gate = block("Gate Driver") [role: actuator]
inv = block("3-Phase MOSFET\nInverter") [role: actuator]
motor = block("BLDC Motor") [role: plant]
load = block("Gearbox + Joint\nLoad") [role: plant]
joint = block("Joint Speed") [role: output]
enc = block("Quadrature\nEncoder") [role: sensor]
filt = block("Speed Estimator\n+ Low-Pass Filter") [role: sensor]
err = sum(+cmd, -filt)
cmd -> err ["ω_ref"]
err -> pid ["error e"]
pid -> curlim ["T*"]
curlim -> pwm ["i*"]
pwm -> gate ["duty d"]
gate -> inv ["PWM"]
inv -> motor ["v_abc"]
motor -> load ["T_m"]
load -> joint ["ω_out"]
load -> enc ["θ_m"]
enc -> filt ["A/B"]
filt -> err ["ω_fb"]
