# Scenario: Purchase-to-pay (P2P) — requisition through approval, purchase order,
# parallel goods receipt / invoice capture, three-way match and payment.
epc "Purchase to Pay"
  layout: tb

  event    E1 "Purchase requisition raised"
  function F1 "Check budget and supplier"
  xor      X1
  event    E2 "Within spending limit"
  event    E3 "Above spending limit"
  function F2 "Approve at cost centre"
  function F3 "Approve by finance head"
  xor      X2
  event    E4 "Requisition approved"
  function F4 "Issue purchase order"
  event    E5 "Purchase order issued"
  and      A1
  function F5 "Post goods receipt"
  function F6 "Capture supplier invoice"
  event    E6 "Goods receipt posted"
  event    E7 "Invoice captured"
  and      A2
  function F7 "Match invoice and release payment"
  event    E8 "Supplier paid"

  E1 -> F1 -> X1
  X1 -> E2 -> F2 -> X2
  X1 -> E3 -> F3 -> X2
  X2 -> E4 -> F4 -> E5 -> A1
  A1 -> F5 -> E6 -> A2
  A1 -> F6 -> E7 -> A2
  A2 -> F7 -> E8
